diff --git a/backend/src/controllers/requestController.js b/backend/src/controllers/requestController.js
new file mode 100644
index 0000000..5b5936d
--- /dev/null
+++ b/backend/src/controllers/requestController.js
@@ -0,0 +1,249 @@
+const { asyncHandler } = require('../utils/asyncHandler');
+const { ApiError } = require('../utils/ApiError');
+const { recordAudit } = require('../utils/audit');
+const { parsePagination, paginatedResponse } = require('../utils/pagination');
+const { invalidatePrefix } = require('../utils/cache');
+const { normalizePayload, createRequest, applyRequest, computeWarnings } = require('../services/requestService');
+
+// All handlers run inside withRls (see requestRoutes.js), so req.db is the
+// RLS-scoped transaction client: a rep only ever sees requests for distributors
+// in their zones, admin sees everything. Responses go through req.respond so
+// nothing is sent until COMMIT has succeeded.
+
+const REQUEST_SELECT = `
+  SELECT r.*, d.name AS distributor_name, u.name AS requested_by_name, rv.name AS reviewed_by_name
+  FROM requests r
+  JOIN distributors d ON d.id = r.distributor_id
+  LEFT JOIN users u ON u.id = r.requested_by
+  LEFT JOIN users rv ON rv.id = r.reviewed_by`;
+
+function emit(req, event, data) {
+  const io = req.app.get('io');
+  if (io) io.emit(event, data);
+}
+
+const list = asyncHandler(async (req, res) => {
+  const { status, type, mine, distributor_id } = req.query;
+  const { page, pageSize, offset } = parsePagination(req.query);
+  const clauses = [];
+  const params = [];
+
+  if (status) {
+    params.push(status);
+    clauses.push(`r.status = $${params.length}`);
+  }
+  if (type) {
+    params.push(type);
+    clauses.push(`r.type = $${params.length}`);
+  }
+  if (distributor_id) {
+    params.push(distributor_id);
+    clauses.push(`r.distributor_id = $${params.length}`);
+  }
+  if (mine === 'true' || mine === '1') {
+    params.push(req.user.id);
+    clauses.push(`r.requested_by = $${params.length}`);
+  }
+  const where = clauses.length ? `WHERE ${clauses.join(' AND ')}` : '';
+
+  const countResult = await req.db.query(`SELECT COUNT(*)::int AS total FROM requests r ${where}`, params);
+
+  const dataParams = [...params, pageSize, offset];
+  const result = await req.db.query(
+    `${REQUEST_SELECT}
+     ${where}
+     ORDER BY (r.status = 'pending') DESC, r.created_at DESC
+     LIMIT $${dataParams.length - 1} OFFSET $${dataParams.length}`,
+    dataParams
+  );
+  req.respond(200, paginatedResponse(result.rows, countResult.rows[0].total, page, pageSize));
+});
+
+const getOne = asyncHandler(async (req, res) => {
+  const result = await req.db.query(`${REQUEST_SELECT} WHERE r.id = $1`, [req.params.id]);
+  if (result.rows.length === 0) throw new ApiError(404, 'Request not found.');
+
+  const request = result.rows[0];
+  const warnings = await computeWarnings(req.db, request);
+  req.respond(200, { ...request, warnings });
+});
+
+// credit_extension / price_override requests. Order requests are created by
+// orderController.create when a non-admin calls POST /api/orders.
+const create = asyncHandler(async (req, res) => {
+  const { type, distributor_id, payload, reason } = req.body;
+  if (type === 'order') {
+    throw new ApiError(400, 'Order requests are submitted through POST /api/orders.');
+  }
+
+  const normalized = await normalizePayload(req.db, type, payload);
+  const request = await createRequest(req.db, {
+    type,
+    requestedBy: req.user.id,
+    distributorId: distributor_id,
+    payload: normalized,
+    reason: reason || null,
+  });
+
+  req.afterCommit(() => emit(req, 'request:created', { requestId: request.id, type }));
+  req.respond(201, request);
+});
+
+// Explains why a pending-only UPDATE matched nothing: the request either
+// doesn't exist (or isn't visible to this user) or was already actioned.
+async function explainNotPending(db, id) {
+  const existing = await db.query('SELECT status FROM requests WHERE id = $1', [id]);
+  if (existing.rows.length === 0) throw new ApiError(404, 'Request not found.');
+  throw new ApiError(409, `This request was already ${existing.rows[0].status}.`);
+}
+
+// Admin only (see requestRoutes.js). The UPDATE ... WHERE status = 'pending' is
+// the concurrency guard: if two admins approve at once, the second blocks on the
+// row lock, then re-checks the WHERE and matches nothing -> 409.
+const approve = asyncHandler(async (req, res) => {
+  const { id } = req.params;
+  const note = req.body.review_note || null;
+
+  const claimed = await req.db.query(
+    `UPDATE requests
+     SET status = 'approved', reviewed_by = $2, reviewed_at = now(), review_note = $3
+     WHERE id = $1 AND status = 'pending'
+     RETURNING *`,
+    [id, req.user.id, note]
+  );
+  if (claimed.rows.length === 0) await explainNotPending(req.db, id);
+  const request = claimed.rows[0];
+
+  // If this throws, withRls rolls everything back — including the status
+  // change above — so a request is never "approved" without its effect.
+  const { resultId, order } = await applyRequest(req.db, request, req.user.id);
+
+  const updated = await req.db.query('UPDATE requests SET result_id = $2 WHERE id = $1 RETURNING *', [id, resultId]);
+
+  await recordAudit(req.db, {
+    userId: req.user.id,
+    action: 'APPROVE',
+    entityType: 'request',
+    entityId: Number(id),
+    before: request,
+    after: updated.rows[0],
+  });
+
+  req.afterCommit(() => {
+    invalidatePrefix('route:/api/reports');
+    emit(req, 'request:reviewed', { requestId: Number(id), status: 'approved' });
+    if (order) emit(req, 'order:created', { orderId: order.id, distributorId: request.distributor_id });
+  });
+
+  req.respond(200, updated.rows[0]);
+});
+
+const reject = asyncHandler(async (req, res) => {
+  const { id } = req.params;
+  const note = req.body.review_note || null;
+
+  const rejected = await req.db.query(
+    `UPDATE requests
+     SET status = 'rejected', reviewed_by = $2, reviewed_at = now(), review_note = $3
+     WHERE id = $1 AND status = 'pending'
+     RETURNING *`,
+    [id, req.user.id, note]
+  );
+  if (rejected.rows.length === 0) await explainNotPending(req.db, id);
+
+  await recordAudit(req.db, {
+    userId: req.user.id,
+    action: 'REJECT',
+    entityType: 'request',
+    entityId: Number(id),
+    after: rejected.rows[0],
+  });
+
+  req.afterCommit(() => emit(req, 'request:reviewed', { requestId: Number(id), status: 'rejected' }));
+  req.respond(200, rejected.rows[0]);
+});
+
+// Only the person who submitted a still-pending request can withdraw it.
+// (An admin who wants to turn one down uses reject.)
+const cancel = asyncHandler(async (req, res) => {
+  const { id } = req.params;
+
+  const existing = await req.db.query('SELECT requested_by, status FROM requests WHERE id = $1', [id]);
+  if (existing.rows.length === 0) throw new ApiError(404, 'Request not found.');
+  if (existing.rows[0].requested_by !== req.user.id) {
+    throw new ApiError(403, 'Only the person who submitted a request can cancel it.');
+  }
+
+  const cancelled = await req.db.query(
+    `UPDATE requests SET status = 'cancelled', reviewed_at = now()
+     WHERE id = $1 AND status = 'pending'
+     RETURNING *`,
+    [id]
+  );
+  if (cancelled.rows.length === 0) {
+    throw new ApiError(409, `This request was already ${existing.rows[0].status}.`);
+  }
+
+  await recordAudit(req.db, {
+    userId: req.user.id,
+    action: 'CANCEL',
+    entityType: 'request',
+    entityId: Number(id),
+    after: cancelled.rows[0],
+  });
+
+  req.afterCommit(() => emit(req, 'request:reviewed', { requestId: Number(id), status: 'cancelled' }));
+  req.respond(200, cancelled.rows[0]);
+});
+
+// ── Approved special prices (read by the order form; revoked by admin) ──
+
+const listOverrides = asyncHandler(async (req, res) => {
+  const { distributor_id, product_id, include_inactive } = req.query;
+  const clauses = [];
+  const params = [];
+
+  if (include_inactive !== 'true' && include_inactive !== '1') clauses.push('po.active = true');
+  if (distributor_id) {
+    params.push(distributor_id);
+    clauses.push(`po.distributor_id = $${params.length}`);
+  }
+  if (product_id) {
+    params.push(product_id);
+    clauses.push(`po.product_id = $${params.length}`);
+  }
+  const where = clauses.length ? `WHERE ${clauses.join(' AND ')}` : '';
+
+  const result = await req.db.query(
+    `SELECT po.*, p.name AS product_name, p.price AS catalog_price, d.name AS distributor_name
+     FROM price_overrides po
+     JOIN products p ON p.id = po.product_id
+     JOIN distributors d ON d.id = po.distributor_id
+     ${where}
+     ORDER BY po.created_at DESC`,
+    params
+  );
+  req.respond(200, result.rows);
+});
+
+// Admin only: revoke (active=false) or re-enable an override.
+const setOverrideActive = asyncHandler(async (req, res) => {
+  const { id } = req.params;
+  const { active } = req.body;
+  if (typeof active !== 'boolean') throw new ApiError(400, 'active must be true or false.');
+
+  const result = await req.db.query('UPDATE price_overrides SET active = $2 WHERE id = $1 RETURNING *', [id, active]);
+  if (result.rows.length === 0) throw new ApiError(404, 'Price override not found.');
+
+  await recordAudit(req.db, {
+    userId: req.user.id,
+    action: active ? 'ENABLE' : 'REVOKE',
+    entityType: 'price_override',
+    entityId: Number(id),
+    after: result.rows[0],
+  });
+
+  req.respond(200, result.rows[0]);
+});
+
+module.exports = { list, getOne, create, approve, reject, cancel, listOverrides, setOverrideActive };
diff --git a/backend/src/db/schema.sql b/backend/src/db/schema.sql
index 05c0cea..90ba399 100644
--- a/backend/src/db/schema.sql
+++ b/backend/src/db/schema.sql
@@ -94,6 +94,8 @@ CREATE TABLE IF NOT EXISTS user_zones (
 CREATE INDEX IF NOT EXISTS idx_user_zones_zone ON user_zones(zone_id);
 
 ALTER TABLE distributors ADD COLUMN IF NOT EXISTS zone_id INTEGER REFERENCES zones(id);
+-- distributorController reads/writes `address`, but no migration ever created it.
+ALTER TABLE distributors ADD COLUMN IF NOT EXISTS address TEXT;
 CREATE INDEX IF NOT EXISTS idx_distributors_zone_id ON distributors(zone_id);
 
 -- ─────────────────────────────────────────────────────────────
@@ -147,7 +149,7 @@ CREATE TABLE IF NOT EXISTS ledger (
   distributor_id    INTEGER NOT NULL REFERENCES distributors(id) ON DELETE RESTRICT,
   order_id          INTEGER REFERENCES orders(id) ON DELETE SET NULL,
   entry_date        TIMESTAMPTZ NOT NULL DEFAULT now(),
-  type              TEXT NOT NULL CHECK (type IN ('Cash', 'credit')), -- debit = owes more (order), credit = payment received
+  type              TEXT NOT NULL CHECK (type IN ('debit', 'credit')), -- debit = owes more (order), credit = payment received
   amount            NUMERIC(14,2) NOT NULL CHECK (amount > 0),
   running_balance   NUMERIC(14,2) NOT NULL,
   note              TEXT,
@@ -427,3 +429,150 @@ EXCEPTION WHEN duplicate_object THEN NULL;
 END $$;
 
 COMMIT;
+
+-- ─────────────────────────────────────────────────────────────
+-- Requests & approval workflow. Sales reps submit requests (order creation,
+-- credit-limit raise, special price); an admin approves/rejects them. All
+-- statements are idempotent, like the rest of this file.
+-- ─────────────────────────────────────────────────────────────
+BEGIN;
+
+-- NULL = no limit is enforced/flagged for this distributor.
+ALTER TABLE distributors ADD COLUMN IF NOT EXISTS credit_limit NUMERIC(12,2)
+  CHECK (credit_limit IS NULL OR credit_limit >= 0);
+
+CREATE TABLE IF NOT EXISTS requests (
+  id              SERIAL PRIMARY KEY,
+  type            TEXT NOT NULL CHECK (type IN ('order', 'credit_extension', 'price_override')),
+  status          TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'approved', 'rejected', 'cancelled')),
+  requested_by    INTEGER NOT NULL REFERENCES users(id),
+  distributor_id  INTEGER NOT NULL REFERENCES distributors(id),
+  payload         JSONB NOT NULL,          -- type-specific proposed data (see requestController.js)
+  reason          TEXT,
+  reviewed_by     INTEGER REFERENCES users(id),
+  review_note     TEXT,
+  result_id       INTEGER,                 -- order id once an order request is approved
+  created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
+  reviewed_at     TIMESTAMPTZ
+);
+CREATE INDEX IF NOT EXISTS idx_requests_status ON requests(status, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_requests_distributor ON requests(distributor_id);
+CREATE INDEX IF NOT EXISTS idx_requests_requested_by ON requests(requested_by);
+
+-- One approved special price per distributor + product (re-approval replaces it).
+CREATE TABLE IF NOT EXISTS price_overrides (
+  id              SERIAL PRIMARY KEY,
+  distributor_id  INTEGER NOT NULL REFERENCES distributors(id),
+  product_id      INTEGER NOT NULL REFERENCES products(id),
+  price           NUMERIC(12,2) NOT NULL CHECK (price >= 0),
+  approved_by     INTEGER NOT NULL REFERENCES users(id),
+  request_id      INTEGER NOT NULL REFERENCES requests(id),
+  active          BOOLEAN NOT NULL DEFAULT true,
+  created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
+  UNIQUE (distributor_id, product_id)
+);
+
+-- requests: admin sees/changes everything; a rep sees requests for distributors
+-- in their zones, may only INSERT their own (in a zone they cover), and may only
+-- UPDATE (cancel) their own. Only admin can DELETE.
+ALTER TABLE requests ENABLE ROW LEVEL SECURITY;
+ALTER TABLE requests FORCE ROW LEVEL SECURITY;
+
+DO $$ BEGIN
+  CREATE POLICY requests_select ON requests FOR SELECT
+  USING (
+    current_setting('app.role', true) = 'admin'
+    OR EXISTS (
+      SELECT 1
+      FROM distributors d
+      JOIN user_zones uz ON uz.zone_id = d.zone_id
+      WHERE d.id = requests.distributor_id
+        AND uz.user_id = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+    )
+  );
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE POLICY requests_insert ON requests FOR INSERT
+  WITH CHECK (
+    current_setting('app.role', true) = 'admin'
+    OR (
+      requested_by = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+      AND EXISTS (
+        SELECT 1
+        FROM distributors d
+        JOIN user_zones uz ON uz.zone_id = d.zone_id
+        WHERE d.id = requests.distributor_id
+          AND uz.user_id = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+      )
+    )
+  );
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE POLICY requests_update ON requests FOR UPDATE
+  USING (
+    current_setting('app.role', true) = 'admin'
+    OR requested_by = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+  )
+  WITH CHECK (
+    current_setting('app.role', true) = 'admin'
+    OR requested_by = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+  );
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE POLICY requests_delete ON requests FOR DELETE
+  USING (current_setting('app.role', true) = 'admin');
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+-- price_overrides: reps can read overrides for their zones' distributors (so
+-- the order form can offer them); only admin can write (via request approval).
+ALTER TABLE price_overrides ENABLE ROW LEVEL SECURITY;
+ALTER TABLE price_overrides FORCE ROW LEVEL SECURITY;
+
+DO $$ BEGIN
+  CREATE POLICY price_overrides_select ON price_overrides FOR SELECT
+  USING (
+    current_setting('app.role', true) = 'admin'
+    OR EXISTS (
+      SELECT 1
+      FROM distributors d
+      JOIN user_zones uz ON uz.zone_id = d.zone_id
+      WHERE d.id = price_overrides.distributor_id
+        AND uz.user_id = NULLIF(current_setting('app.user_id', true), '')::INTEGER
+    )
+  );
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE POLICY price_overrides_admin_write ON price_overrides FOR ALL
+  USING (current_setting('app.role', true) = 'admin')
+  WITH CHECK (current_setting('app.role', true) = 'admin');
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+-- Fix: the original constraint allowed ('Cash','credit') but ledgerService
+-- writes 'debit'/'credit', so every order creation failed. Existing databases
+-- still carry the old constraint; replace it. NOT VALID enforces the new rule
+-- on all new rows without failing the deploy if any legacy row has an old value.
+-- Guarded so re-running schema.sql is a no-op once the fix is in place.
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT 1 FROM pg_constraint
+    WHERE conname = 'ledger_type_check'
+      AND conrelid = 'ledger'::regclass
+      AND pg_get_constraintdef(oid) LIKE '%Cash%'
+  ) THEN
+    ALTER TABLE ledger DROP CONSTRAINT ledger_type_check;
+    ALTER TABLE ledger ADD CONSTRAINT ledger_type_check CHECK (type IN ('debit', 'credit')) NOT VALID;
+  END IF;
+END $$;
+
+COMMIT;
