# Used by docker-compose.yml (copy to .env in this same folder — compose
# reads .env automatically, no extra flag needed).

# Postgres
POSTGRES_PASSWORD=

# Backend
# Must be 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Your real, deployed frontend URL — e.g. https://ledgerone.yourdomain.com
# Must NOT be left blank or "*" — the backend refuses to start in production without a real value.
CLIENT_ORIGIN=

# First admin login, created automatically on first startup
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Frontend (optional — only needed if using the Google Drive backup feature)
# See GOOGLE_DRIVE_SETUP.md. Public value, safe to set here.
VITE_GOOGLE_CLIENT_ID=

# Which host port nginx (the frontend container) listens on
FRONTEND_PORT=80
