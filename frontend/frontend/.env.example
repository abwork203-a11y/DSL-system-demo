# Google Drive Backup feature
# See GOOGLE_DRIVE_SETUP.md for how to get this value. This is a *public*
# OAuth Client ID (safe to embed in frontend code) — not a secret.
VITE_GOOGLE_CLIENT_ID=

# Backend API base URL. Optional for local dev — if left blank, requests go
# to a relative '/api' path, which the Vite dev server proxy (see
# vite.config.js) forwards to http://localhost:4000. Required in production
# (e.g. your Render backend URL), since there's no dev proxy once deployed.
VITE_API_URL=
